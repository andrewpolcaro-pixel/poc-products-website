# WordPress REST API base URL (no trailing slash)
NEXT_PUBLIC_WP_API_URL=https://wordpress-1633433-6466395.cloudwaysapps.com/wp-json/wp/v2

# Draft preview — must match POC_PREVIEW_SECRET in wp-config.php
PREVIEW_SECRET=replace-with-a-long-random-string

# WordPress Application Password for fetching draft posts (server-side only)
# Generate in WP Admin → Users → Edit User → Application Passwords
# Format: base64("wpusername:xxxx xxxx xxxx xxxx xxxx xxxx")
WP_PREVIEW_TOKEN=
